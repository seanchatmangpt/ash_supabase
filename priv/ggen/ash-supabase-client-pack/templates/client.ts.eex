// GENERATED by `mix ash_supabase.gen_client` (ggen_igniter, pack
// ash-supabase-client-pack) -- DO NOT HAND-EDIT.
//
// Regenerate after changing any resource's `gateway_actions`,
// attributes, or action arguments:
//
//     mix ash_supabase.export_ontology
//     mix ggen_igniter.sync --pack ash-supabase-client-pack --out <this file>
//
// (or `mix ash_supabase.gen_client`, which runs both in sequence.)
//
// A TypeScript developer importing this file calls plain, typed local
// functions and the ordinary supabase-js client -- nothing here mentions
// Ash, Elixir, Reactor, or any backend framework term. Every function
// below posts to the single generic "ash-gateway" Supabase Edge Function
// (see supabase/functions/ash-gateway/index.ts) -- the only thing that
// ever talks to Ash on the wire.

import type { SupabaseClient } from "@supabase/supabase-js";

async function invokeAshGateway<T>(
  supabase: SupabaseClient,
  resource: string,
  action: string,
  params: Record<string, unknown>,
): Promise<T> {
  const { data, error } = await supabase.functions.invoke("ash-gateway", {
    body: { resource, action, params },
  });
  if (error) throw error;
  return data as T;
}
<%= for row <- resource_types do %>
<% fields = Jason.decode!(row["fields_json"]) %>
export interface <%= row["ts_interface_name"] %> {
<%= for f <- fields do %>  <%= f["name"] %>: <%= f["tsType"] %>;
<% end %>}
<% end %>
<%= for row <- actions do %>
<% params = Jason.decode!(row["params_json"]) %>
<% fn_name = row["ts_function_name"] %>
<% pascal_name = String.upcase(String.at(fn_name, 0)) <> String.slice(fn_name, 1..-1//1) %>
export interface <%= pascal_name %>Params {
<%= for p <- params do %>  <%= p["name"] %><%= if !p["required"], do: "?" %>: <%= p["tsType"] %>;
<% end %>}

export async function <%= fn_name %>(
  supabase: SupabaseClient,
  params: <%= pascal_name %>Params,
): Promise<<%= row["ts_return_type"] %>> {
  return invokeAshGateway<<%= row["ts_return_type"] %>>(
    supabase,
    "<%= row["resource_name"] %>",
    "<%= row["action_name"] %>",
    params as unknown as Record<string, unknown>,
  );
}
<% end %>
